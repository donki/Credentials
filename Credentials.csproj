<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Android y Windows con el mismo proyecto (constitucion anexo A.1). El destino WinUI solo
         existe compilando desde Windows. -->
    <TargetFrameworks>net10.0-android36.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Credentials</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- El lanzador de un solo exe (Launcher\) y el host de mensajeria nativa (Host\) son otros
         proyectos: fuera de este. La extension (Extension\) no es codigo .NET. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Launcher\**;Host\**;Extension\**</DefaultItemExcludes>

    <!-- Display name -->
    <ApplicationTitle>sOC Credentials</ApplicationTitle>
    <!-- En el movil la app se llama «Credentials» a secas (icono, ajustes, autocompletar). -->
    <ApplicationTitle Condition="$(TargetFramework.Contains('android'))">Credentials</ApplicationTitle>

    <!-- App Identifier (constitucion A.2: com.socratic.[nombre-aplicacion]) -->
    <ApplicationId>com.socratic.credentials</ApplicationId>

    <!-- Versions (constitucion 11 / A.4: ambos valores en sincronia) -->
    <ApplicationDisplayVersion>2026.09.23.03</ApplicationDisplayVersion>
    <ApplicationVersion>2026092303</ApplicationVersion>

    <!-- Accept Android SDK Licenses -->
    <AcceptAndroidSDKLicenses>true</AcceptAndroidSDKLicenses>

    <!-- Package Information -->
    <PackageId>Credentials</PackageId>
    <Title>sOC Credentials</Title>
    <Product>sOC Credentials</Product>
    <Description>Gestor de credenciales y segundo factor (TOTP) para Android y Windows: boveda cifrada en local o en tu Google Drive/OneDrive.</Description>
    <Copyright>Copyright © 2026 Socratic</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>passwords;credentials;totp;2fa;vault;android;windows;maui</PackageTags>
    <Authors>Socratic</Authors>
    <Company>Socratic</Company>

    <!-- Platform versions -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

    <!-- Android specific -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <TargetSdkVersion>36</TargetSdkVersion>
    <AndroidUseLatestPlatformSdk>false</AndroidUseLatestPlatformSdk>
    <AndroidUseAapt2>true</AndroidUseAapt2>
    <AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>
    <UseInterpreter>false</UseInterpreter>

    <AssemblyVersion>2026.9.23.3</AssemblyVersion>
    <FileVersion>2026.9.23.3</FileVersion>
  </PropertyGroup>

  <!-- Windows: sin empaquetar durante el desarrollo (el exe arranca directamente); el MSIX para la
       Store lo genera tools\empaquetar-msix.ps1 con WindowsPackageType=MSIX. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <UseRidGraph>true</UseRidGraph>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>


  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <!-- BiometricPrompt (huella / cara) para desbloquear; Apache 2.0. -->
    <PackageReference Include="Xamarin.AndroidX.Biometric" Version="1.1.0.32" />
  </ItemGroup>

  <!-- Release configuration for Android -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidKeyStore>false</AndroidKeyStore>
    <RunAOTCompilation>false</RunAOTCompilation>
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>

  <!--
    Ensamblados embebidos en cualquier despliegue, Debug y Release (constitucion A.7).
    Con Fast Deployment los ensamblados no viajan en el APK y la app aborta al arrancar
    con "No assemblies found".
  -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icono de la aplicacion: caja/papelera sobre fondo teal (tematica de desinstalacion) -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#3525CD" />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#3525CD" BaseSize="200,200" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />

    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <!-- Lectura de QR (otpauth) con la camara; Apache 2.0 / MIT. -->
    <PackageReference Include="ZXing.Net.Maui.Controls" Version="0.10.4" />
    <!-- Argon2id para derivar la clave de la contraseña maestra; MIT. -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>

  <!-- Notas de autor compartidas (una sola fuente para todas las apps) -->
  <ItemGroup>
    <Compile Include="..\Shared\AuthorNotes.cs" Link="AuthorNotes.cs" />
    <Compile Include="..\Shared\ModernDialog.cs" Link="ModernDialog.cs" />
  </ItemGroup>

  <Import Project="..\Shared\signing.props" />
  <Import Project="oauth.props" />
  <!-- Windows: la extension de navegador (desempaquetada) y el host de mensajeria nativa van dentro
       de la carpeta de la aplicacion; ExtensionInstaller los copia y registra desde ahi. El host lo
       compila antes tools\publicar-windows.ps1 (o a mano: dotnet publish Host -c Release). -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <Content Include="Extension\common\**" Link="Extension\common\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Extension\chromium\manifest.json" Link="Extension\chromium\manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Extension\firefox\manifest.json" Link="Extension\firefox\manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Host\bin\Release\net10.0\win-x64\publish\CredentialsHost.exe" Link="CredentialsHost.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Host\bin\Release\net10.0\win-x64\publish\CredentialsHost.exe')" />
  </ItemGroup>

</Project>
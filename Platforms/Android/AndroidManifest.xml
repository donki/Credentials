<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!--
    Permisos (constitucion 6 y A.3: justificar cada permiso, minimo privilegio).

    CAMERA: leer el QR que enseñan los sitios al activar el segundo factor y el QR de exportacion
    de Google Authenticator. Se pide solo al pulsar «Escanear».
    INTERNET: solo para la boveda en Google Drive u OneDrive (entrar con la cuenta y subir/bajar el
    fichero cifrado). Con la boveda en local no se usa.
    USE_BIOMETRIC: desbloquear con huella o cara (BiometricPrompt).
  -->
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-feature android:name="android.hardware.camera" android:required="false" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.USE_BIOMETRIC" />

  <application android:allowBackup="false"
               android:icon="@mipmap/appicon"
               android:roundIcon="@mipmap/appicon_round"
               android:supportsRtl="true">
    <!-- Vuelta del navegador tras entrar con Microsoft (esquema propio) o Google (el identificador
         de cliente invertido, que pone oauth.props como marcador). La clase es
         WebAuthenticationCallbackActivity, pero al declarar aqui la actividad el generador ya no
         añade nada de sus atributos de C#: TODO lo suyo (los dos filtros, noHistory, launchMode)
         tiene que estar en este bloque. -->
    <activity android:name="com.socratic.credentials.AuthCallback" android:exported="true"
              android:noHistory="true" android:launchMode="singleTop">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="com.socratic.credentials" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="${googleScheme}" />
      </intent-filter>
    </activity>
  </application>

  <queries>
    <!-- Autocompletar: el nombre visible de la app en la que se escribio la contraseña (titulo de la
         entrada nueva). Desde Android 11 solo se ven los paquetes declarados aqui; con esto se ven
         las apps que tienen icono en el lanzador, que son las que tienen pantallas de acceso. -->
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
    <!-- Boton de contacto de la pagina Acerca de. -->
    <intent>
      <action android:name="android.intent.action.SENDTO" />
      <data android:scheme="mailto" />
    </intent>
    <!-- Abrir el sitio web de una entrada. -->
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="https" />
    </intent>
  </queries>

</manifest>

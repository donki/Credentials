<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Credentials.Pages.SettingsPage">

    <ScrollView>
        <VerticalStackLayout Padding="12" Spacing="10" MaximumWidthRequest="760" HorizontalOptions="Fill">

            <!-- Idioma -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="16,12" Spacing="10">
                    <Label x:Name="LanguageTitle" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0" x:Name="SpanishButton" Text="Español" ImageSource="ic_flag_es.png" ContentLayout="Left,8" FontSize="14" Padding="10,10" Clicked="OnSpanishClicked" />
                        <Button Grid.Column="1" x:Name="EnglishButton" Text="English" ImageSource="ic_flag_us.png" ContentLayout="Left,8" FontSize="14" Padding="10,10" Clicked="OnEnglishClicked" />
                    </Grid>
                    <Label x:Name="LanguageHint" Style="{StaticResource HintText}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Donde vive la boveda: tres botones, como los de entrar en Task Manager; el elegido
                 va con el estilo primario y una marca. -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="16,12" Spacing="8">
                    <Label x:Name="StorageTitle" Style="{StaticResource SectionTitle}" />
                    <Label x:Name="StorageHint" Style="{StaticResource HintText}" />
                    <Button x:Name="LocalButton" ImageSource="ic_lock.png" ContentLayout="Left,10" HorizontalOptions="Fill" Clicked="OnStorageClicked" CommandParameter="Local" />
                    <Button x:Name="GoogleButton" ImageSource="ic_google.png" ContentLayout="Left,10" HorizontalOptions="Fill" Clicked="OnStorageClicked" CommandParameter="GoogleDrive" />
                    <Button x:Name="OneDriveButton" ImageSource="ic_microsoft.png" ContentLayout="Left,10" HorizontalOptions="Fill" Clicked="OnStorageClicked" CommandParameter="OneDrive" />
                    <Label x:Name="AccountLabel" Style="{StaticResource HintText}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" x:Name="SyncButton" Style="{StaticResource OutlineButton}" ImageSource="ic_sync.png" ContentLayout="Left,6" Clicked="OnSyncClicked" />
                        <Button Grid.Column="1" x:Name="SignOutButton" Style="{StaticResource OutlineButton}" Clicked="OnSignOutClicked" />
                    </Grid>
                    <Label x:Name="SyncStatus" Style="{StaticResource HintText}" />
                </VerticalStackLayout>
            </Border>

            <!-- Seguridad -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="16,12" Spacing="8">
                    <Label x:Name="SecurityTitle" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label x:Name="TrustLabel" Style="{StaticResource BodyText}" />
                            <Label x:Name="TrustHint" Style="{StaticResource HintText}" FontSize="11" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" x:Name="TrustSwitch" OnColor="{StaticResource Primary}" Toggled="OnTrustToggled" VerticalOptions="Center" />
                    </Grid>
                    <Grid x:Name="BiometricsRow" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label x:Name="BiometricsLabel" Style="{StaticResource BodyText}" />
                            <Label x:Name="BiometricsHint" Style="{StaticResource HintText}" FontSize="11" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" x:Name="BiometricsSwitch" OnColor="{StaticResource Primary}" Toggled="OnBiometricsToggled" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" x:Name="AutoLockLabel" Style="{StaticResource BodyText}" VerticalOptions="Center" />
                        <Picker Grid.Column="1" x:Name="AutoLockPicker" SelectedIndexChanged="OnAutoLockChanged" MinimumWidthRequest="120" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" x:Name="ClipboardLabel" Style="{StaticResource BodyText}" VerticalOptions="Center" />
                        <Picker Grid.Column="1" x:Name="ClipboardPicker" SelectedIndexChanged="OnClipboardChanged" MinimumWidthRequest="120" />
                    </Grid>
                    <Button x:Name="ChangeMasterButton" Style="{StaticResource OutlineButton}" ImageSource="ic_key.png" ContentLayout="Left,6" Clicked="OnChangeMasterClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- Importar y exportar -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="16,12" Spacing="8">
                    <Label x:Name="DataTitle" Style="{StaticResource SectionTitle}" />
                    <Label x:Name="ImportHint" Style="{StaticResource HintText}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" x:Name="ImportButton" Style="{StaticResource PrimaryButton}" ImageSource="ic_import_w.png" ContentLayout="Left,6" Clicked="OnImportClicked" />
                        <Button Grid.Column="1" x:Name="ImportGaButton" Style="{StaticResource OutlineButton}" ImageSource="ic_scan.png" ContentLayout="Left,6" Clicked="OnImportGaClicked" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" x:Name="ExportEncButton" Style="{StaticResource OutlineButton}" ImageSource="ic_export.png" ContentLayout="Left,6" Clicked="OnExportEncryptedClicked" />
                        <Button Grid.Column="1" x:Name="ExportPlainButton" Style="{StaticResource OutlineButton}" ImageSource="ic_export.png" ContentLayout="Left,6" Clicked="OnExportPlainClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Autocompletar: en Android, el servicio del sistema (solo uno: elegir este desconecta el
                 otro gestor); en Windows, la lista pegada a los campos de contraseña de las aplicaciones. -->
            <Border x:Name="AutofillCard" Style="{StaticResource Card}" IsVisible="False">
                <VerticalStackLayout Padding="16,12" Spacing="8">
                    <Label x:Name="AutofillTitle" Style="{StaticResource SectionTitle}" />
                    <Label x:Name="AutofillStatus" Style="{StaticResource HintText}" />
                    <Button x:Name="AutofillButton" ImageSource="ic_key_w.png" ContentLayout="Left,6" Style="{StaticResource PrimaryButton}" Clicked="OnAutofillClicked" />
                    <!-- Android 14+: el «servicio preferido de contraseñas» manda sobre el de autocompletar
                         en los navegadores; y cada navegador Chromium tiene ademas su propio gestor. -->
                    <Label x:Name="PreferredHint" Style="{StaticResource HintText}" IsVisible="False" />
                    <Button x:Name="PreferredButton" ImageSource="ic_key.png" ContentLayout="Left,6" Style="{StaticResource OutlineButton}" Clicked="OnPreferredClicked" IsVisible="False" />
                    <Label x:Name="BrowsersHint" Style="{StaticResource HintText}" IsVisible="False" />
                    <Button x:Name="BrowsersButton" ImageSource="ic_open.png" ContentLayout="Left,6" Style="{StaticResource OutlineButton}" Clicked="OnBrowserSettingsClicked" IsVisible="False" />
                    <Grid x:Name="AutofillAskRow" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label x:Name="AutofillAskLabel" Style="{StaticResource BodyText}" />
                            <Label x:Name="AutofillAskHint" Style="{StaticResource HintText}" FontSize="11" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" x:Name="AutofillAskSwitch" OnColor="{StaticResource Primary}" Toggled="OnAutofillAskToggled" VerticalOptions="Center" />
                    </Grid>
                    <Grid x:Name="DesktopAutofillRow" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label x:Name="DesktopAutofillLabel" Style="{StaticResource BodyText}" />
                            <Label x:Name="DesktopAutofillHint" Style="{StaticResource HintText}" FontSize="11" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" x:Name="DesktopAutofillSwitch" OnColor="{StaticResource Primary}" Toggled="OnDesktopAutofillToggled" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Windows: bandeja y arranque -->
            <Border x:Name="WindowsCard" Style="{StaticResource Card}" IsVisible="False">
                <VerticalStackLayout Padding="16,12" Spacing="8">
                    <Label x:Name="WindowsTitle" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label x:Name="TrayLabel" Style="{StaticResource BodyText}" />
                            <Label x:Name="TrayHint" Style="{StaticResource HintText}" FontSize="11" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" x:Name="TraySwitch" OnColor="{StaticResource Primary}" Toggled="OnTrayToggled" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label x:Name="StartupLabel" Style="{StaticResource BodyText}" />
                            <Label x:Name="StartupHint" Style="{StaticResource HintText}" FontSize="11" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" x:Name="StartupSwitch" OnColor="{StaticResource Primary}" Toggled="OnStartupToggled" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Windows: extensiones de navegador -->
            <Border x:Name="ExtensionsCard" Style="{StaticResource Card}" IsVisible="False">
                <VerticalStackLayout Padding="16,12" Spacing="8">
                    <Label x:Name="ExtTitle" Style="{StaticResource SectionTitle}" />
                    <Label x:Name="ExtHint" Style="{StaticResource HintText}" />
                    <VerticalStackLayout x:Name="BrowsersBox" Spacing="6" />
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label x:Name="ExtAskLabel" Style="{StaticResource BodyText}" />
                            <Label x:Name="ExtAskHint" Style="{StaticResource HintText}" FontSize="11" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" x:Name="ExtAskSwitch" OnColor="{StaticResource Primary}" Toggled="OnExtAskToggled" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Zona peligrosa -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="16,12" Spacing="8">
                    <Label x:Name="DangerTitle" Style="{StaticResource SectionTitle}" TextColor="{StaticResource Danger}" />
                    <Button x:Name="DeleteVaultButton" Style="{StaticResource DangerButton}" Clicked="OnDeleteVaultClicked" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

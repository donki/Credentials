<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pruebas de la interfaz de sOC Credentials: la aplicacion de verdad (Credentials.csproj en su
    destino net10.0, sin plataforma) con sus paginas, el Shell y App construidos de verdad. Lo que
    solo existe en el dispositivo (dialogos, navegacion del Shell, portapapeles, compartir, lector QR,
    biometria, Preferences, SecureStorage, carpeta de datos) va con dobles en memoria (TestHost.cs):
    nada toca la boveda real, la red ni el registro de Windows.
    Ejecutar: dotnet test Credentials.Tests\Ui
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Credentials.Ui.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- xunit (Apache-2.0), su runner (Apache-2.0), Microsoft.NET.Test.Sdk (MIT) y coverlet (MIT): solo para probar, no se distribuyen. -->
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Microsoft.Maui" />
    <Using Include="Microsoft.Maui.Controls" />
    <Using Include="Microsoft.Maui.Storage" />
    <Using Include="Microsoft.Maui.ApplicationModel" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Credentials.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- El servidor HTTP de mentira de las pruebas de la logica. -->
    <Compile Include="..\FakeHttp.cs" Link="FakeHttp.cs" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pruebas del codigo de Windows de sOC Credentials (Platforms\Windows), enlazado en la biblioteca
    Lib\Credentials.WindowsLib: icono de bandeja y su menu (sin ponerlo de verdad), minimizar con el
    tamaño de vuelta, identidad de la barra de tareas sobre una ventana oculta de prueba, la tuberia
    de los navegadores con otro nombre, el autocompletar de escritorio sobre esa ventana, el gestor
    de errores de WinUI... Nada abre ventanas visibles, ni pone iconos, ni toca el registro, ni la
    boveda, ni el primer plano (constitucion General 8.6; ver Credentials.Tests\Ui para las paginas).
    Ejecutar: dotnet test Credentials.Tests\Windows
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Credentials.Windows.Tests</RootNamespace>
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    <!-- Los tipos de MAUI y de WinUI arrancan Windows App SDK: sin empaquetar, con el runtime del
         sistema, que se carga solo al abrir el ensamblado de pruebas. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <WindowsAppSdkBootstrapInitialize>true</WindowsAppSdkBootstrapInitialize>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- xunit (Apache-2.0), su runner (Apache-2.0), Microsoft.NET.Test.Sdk (MIT) y coverlet (MIT): solo para probar, no se distribuyen. -->
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Maui.Controls.Core" Version="10.0.20" />
    <PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.20" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Microsoft.Maui" />
    <Using Include="Microsoft.Maui.Controls" />
    <Using Include="Microsoft.Maui.Storage" />
    <Using Include="Microsoft.Maui.ApplicationModel" />
    <Compile Remove="Lib\**" />
    <None Remove="Lib\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Lib\Credentials.WindowsLib.csproj" />
  </ItemGroup>

</Project>

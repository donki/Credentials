<Project Sdk="Microsoft.NET.Sdk">

  <!--
    El codigo de Windows de sOC Credentials (Platforms\Windows) ENLAZADO tal cual, con lo que
    necesita de la aplicacion, compilado para net10.0-windows con el simbolo WINDOWS y MAUI de
    verdad (Controls.Core y Essentials). Solo existe para las pruebas (Credentials.Windows.Tests): va
    en una biblioteca aparte para que coverlet la mida. Lo que tocaria el PC (el icono de bandeja,
    mostrar ventanas, el primer plano, la tuberia de los navegadores) pasa por costuras que las
    pruebas cambian. La aplicacion no lo usa.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Credentials</RootNamespace>
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    <!-- MAUI en Windows arranca WinUI: sin empaquetar, con el runtime de Windows App SDK del sistema. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <!-- CA1416: el minimo de la app es 17763 y alguna API es de 19041, igual que en la app. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lo mismo que usa la aplicacion (MIT). -->
    <PackageReference Include="Microsoft.Maui.Controls.Core" Version="10.0.20" />
    <PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.20" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Maui" />
    <Using Include="Microsoft.Maui.Controls" />
    <Using Include="Microsoft.Maui.Graphics" />
    <Using Include="Microsoft.Maui.Storage" />
    <Using Include="Microsoft.Maui.ApplicationModel" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <InternalsVisibleTo Include="Credentials.Windows.Tests" />
  </ItemGroup>

  <!-- Lo de Windows, tal cual (menos el arranque de WinUI, App.xaml, y el registro de servicios, que
       necesitan la aplicacion entera). -->
  <ItemGroup>
    <Compile Include="..\..\..\Platforms\Windows\*.cs" Exclude="..\..\..\Platforms\Windows\App.xaml.cs;..\..\..\Platforms\Windows\MauiProgram.Windows.cs" Link="App\Windows\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Lo que necesita de la aplicacion. -->
  <ItemGroup>
    <Compile Include="..\..\..\PlatformLogic\*.cs" Link="App\PlatformLogic\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\Models\VaultData.cs" Link="App\Models\VaultData.cs" />
    <Compile Include="..\..\..\Services\AppLog.cs" Link="App\Services\AppLog.cs" />
    <Compile Include="..\..\..\Services\AutofillLogic.cs" Link="App\Services\AutofillLogic.cs" />
    <Compile Include="..\..\..\Services\Cloud.cs" Link="App\Services\Cloud.cs" />
    <Compile Include="..\..\..\Services\CrashReporting.cs" Link="App\Services\CrashReporting.cs" />
    <Compile Include="..\..\..\Services\IBiometric.cs" Link="App\Services\IBiometric.cs" />
    <Compile Include="..\..\..\Services\IDesktopIntegration.cs" Link="App\Services\IDesktopIntegration.cs" />
    <Compile Include="..\..\..\Services\ILocalizationService.cs" Link="App\Services\ILocalizationService.cs" />
    <Compile Include="..\..\..\Services\ISettingsService.cs" Link="App\Services\ISettingsService.cs" />
    <Compile Include="..\..\..\Services\IToastService.cs" Link="App\Services\IToastService.cs" />
    <Compile Include="..\..\..\Services\LocalizationService.cs" Link="App\Services\LocalizationService.cs" />
    <Compile Include="..\..\..\Services\OAuthSecrets.cs" Link="App\Services\OAuthSecrets.cs" />
    <Compile Include="..\..\..\Services\SettingsService.cs" Link="App\Services\SettingsService.cs" />
    <Compile Include="..\..\..\Services\Totp.cs" Link="App\Services\Totp.cs" />
    <Compile Include="..\..\..\Services\VaultCrypto.cs" Link="App\Services\VaultCrypto.cs" />
    <Compile Include="..\..\..\Services\VaultStore.cs" Link="App\Services\VaultStore.cs" />
    <Compile Include="..\..\..\Helpers\ServiceHelper.cs" Link="App\Helpers\ServiceHelper.cs" />
    <Compile Include="..\..\..\..\Shared\CrashGuard.cs" Link="Shared\CrashGuard.cs" />
    <Compile Include="..\..\..\..\Shared\ModernDialog.cs" Link="Shared\ModernDialog.cs" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pruebas automatizadas de la logica de sOC Credentials. La aplicacion es un solo proyecto MAUI
    (Android + Windows) con la interfaz mezclada, asi que no se referencia: la biblioteca
    Logic\Credentials.Logic enlaza sus ficheros de logica pura (boveda, cifrado, TOTP, importadores,
    nube, autocompletar, textos) y aqui se prueban. La interfaz no se prueba.
    Ejecutar: dotnet test Credentials.Tests
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Credentials.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- xunit (Apache-2.0), su runner (Apache-2.0), Microsoft.NET.Test.Sdk (MIT) y coverlet (MIT): solo para probar, no se distribuyen. -->
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Microsoft.Maui.Storage" />
    <Using Include="Microsoft.Maui.ApplicationModel" />
    <!-- La biblioteca es otro proyecto: sus ficheros no se compilan aqui. -->
    <Compile Remove="Logic\**" />
    <None Remove="Logic\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Logic\Credentials.Logic.csproj" />
  </ItemGroup>

</Project>

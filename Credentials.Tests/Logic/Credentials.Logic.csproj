<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Los ficheros de logica de sOC Credentials, ENLAZADOS tal cual, compilados para net10.0 sin MAUI:
    las pocas piezas de MAUI que tocan (Preferences, SecureStorage, FileSystem, MainThread) y el
    registro (AppLog) se sustituyen por dobles en memoria (Maui.cs). Solo existe para las pruebas
    (Credentials.Tests): va en una biblioteca aparte para que coverlet la mida, porque el codigo
    compilado dentro del propio ensamblado de pruebas no se instrumenta. La aplicacion no lo usa.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Credentials</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lo mismo que usa la aplicacion (MIT). -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Maui.Storage" />
    <Using Include="Microsoft.Maui.ApplicationModel" />
    <InternalsVisibleTo Include="Credentials.Tests" />
  </ItemGroup>

  <!-- Los ficheros de la aplicacion que se prueban, tal cual. -->
  <ItemGroup>
    <Compile Include="..\..\Models\VaultData.cs" Link="App\Models\VaultData.cs" />
    <Compile Include="..\..\Services\AutofillLogic.cs" Link="App\Services\AutofillLogic.cs" />
    <Compile Include="..\..\Services\Cloud.cs" Link="App\Services\Cloud.cs" />
    <Compile Include="..\..\Services\ILocalizationService.cs" Link="App\Services\ILocalizationService.cs" />
    <Compile Include="..\..\Services\ISettingsService.cs" Link="App\Services\ISettingsService.cs" />
    <Compile Include="..\..\Services\Importers.cs" Link="App\Services\Importers.cs" />
    <Compile Include="..\..\Services\LocalizationService.cs" Link="App\Services\LocalizationService.cs" />
    <Compile Include="..\..\Services\OAuthSecrets.cs" Link="App\Services\OAuthSecrets.cs" />
    <Compile Include="..\..\Services\SettingsService.cs" Link="App\Services\SettingsService.cs" />
    <Compile Include="..\..\Services\Totp.cs" Link="App\Services\Totp.cs" />
    <Compile Include="..\..\Services\VaultCrypto.cs" Link="App\Services\VaultCrypto.cs" />
    <Compile Include="..\..\Services\VaultStore.cs" Link="App\Services\VaultStore.cs" />
  </ItemGroup>

  <!-- Identificadores de cliente de mentira: con ellos la nube «esta configurada» y se puede probar
       la entrada contra el servidor falso. Nunca son los de verdad. -->
  <ItemGroup>
    <AssemblyMetadata Include="CrGoogleClientId" Value="cliente-de-prueba.apps.googleusercontent.com" />
    <AssemblyMetadata Include="CrGoogleClientSecret" Value="secreto-de-prueba" />
    <AssemblyMetadata Include="CrMicrosoftClientId" Value="00000000-0000-0000-0000-000000000000" />
  </ItemGroup>

</Project>
